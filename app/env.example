# Turso Database Configuration for Cross-Device Sync
# 1. Sign up or log in: https://turso.tech or via CLI (`turso auth signup`)
# 2. Create a database: `turso db create throughline`
# 3. Get connection URL: `turso db show throughline --url`
# 4. Generate auth token: `turso db tokens create throughline`

TURSO_DATABASE_URL=libsql://throughline-[your-org].turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token
