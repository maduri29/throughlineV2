# Turso Database Configuration for Cross-Device Sync
# 1. Sign up or log in: https://turso.tech or via CLI (`turso auth signup`)
# 2. Create a database: `turso db create story-lane`
# 3. Get connection URL: `turso db show story-lane --url`
# 4. Generate auth token: `turso db tokens create story-lane`

TURSO_DATABASE_URL=libsql://story-lane-[your-org].turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token

# Separate Throughline Firebase project: Project settings > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id

# Provision 1-5 email/password users in Firebase Authentication > Users.
# Optional usernames are aliases, not shared credentials. Never add passwords here.
# Server-only initial accounts. Registry membership is checked on every private API request.
# These entries seed the account registry. New users can register in the login UI.
THROUGHLINE_ACCOUNTS=[{"username":"writer1","email":"writer1@example.com","uid":"copy-firebase-user-uid-1"},{"username":"writer2","email":"writer2@example.com","uid":"copy-firebase-user-uid-2"},{"username":"writer3","email":"writer3@example.com","uid":"copy-firebase-user-uid-3"}]

# Share with intended users so they can create accounts from the login screen.
# At least 12 characters; generate a random secret. Never include this in NEXT_PUBLIC variables.
THROUGHLINE_INVITE_CODE=replace-with-a-random-invitation-secret
