# Turso Database Configuration for Cross-Device Sync
# 1. Sign up or log in: https://turso.tech or via CLI (`turso auth signup`)
# 2. Create a database: `turso db create story-lane`
# 3. Get connection URL: `turso db show story-lane --url`
# 4. Generate auth token: `turso db tokens create story-lane`

TURSO_DATABASE_URL=libsql://story-lane-[your-org].turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token
