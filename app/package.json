{
  "name": "story-lane-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4517",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:bail": "bun test --bail",
    "profile:cpu": "bun --cpu-prof --cpu-prof-md test",
    "profile:heap": "bun --heap-prof --heap-prof-md test",
    "dedupe": "bun dedupe",
    "audit": "bun audit",
    "verify:boneyard": "bun verify-boneyard.ts",
    "verify:boneyard-sync": "bun verify-boneyard-sync.ts",
    "verify:mobile": "bun verify-mobile.ts",
    "verify:library": "bun verify-library.ts",
    "verify:search": "bun verify-search.ts",
    "verify:ui": "bun verify-ui.ts",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun test",
    "start": "next start -p 4517",
    "deploy": "bunx vercel --prod --yes --cwd ..",
    "deploy:prod": "bunx vercel --prod --yes --cwd ..",
    "verify:login": "bun verify-login.ts",
    "verify:accounts": "bun verify-account-api.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@libsql/client": "^0.18.0",
    "@xyflow/react": "^12.12.0",
    "effect": "^3.22.2",
    "firebase": "^12.19.0",
    "firebase-admin": "13.6.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
